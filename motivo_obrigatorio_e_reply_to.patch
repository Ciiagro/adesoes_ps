+<script>
+// Só exige o motivo do cancelamento quando o botão clicado for "Cancelar"
+// — aprovar/marcar como realizada/voltar pra pendente não precisam disso.
+(function () {
+  const form = document.getElementById('form-alterar-status');
+  const inputMotivo = document.getElementById('input-motivo-recusa');
+  const avisoObrigatorio = document.getElementById('motivo-recusa-obrigatorio');
+  let statusClicado = null;
+
+  form.querySelectorAll('button[name="status"]').forEach(function (botao) {
+    botao.addEventListener('click', function () {
+      statusClicado = botao.value;
+    });
+  });
+
+  form.addEventListener('submit', function (evento) {
+    if (statusClicado === 'recusada' && !inputMotivo.value.trim()) {
+      avisoObrigatorio.style.display = 'inline';
+      inputMotivo.focus();
+      evento.preventDefault();
+    } else {
+      avisoObrigatorio.style.display = 'none';
+    }
+  });
+})();
+</script>
