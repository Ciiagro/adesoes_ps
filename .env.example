# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA compartilhe o arquivo .env com a senha real preenchida.

# String de conexão do Supabase (Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxx:SUA_SENHA_AQUI@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave secreta do Flask (para sessão). Gere uma string aleatória qualquer.
SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# Senha de acesso à área Administrativa (equipe SENAR/gestão)
ADMIN_PASSWORD=troque-esta-senha

# Senha de acesso à área da Comissão (se houver um segundo nível de acesso)
COMISSAO_PASSWORD=troque-esta-senha-tambem

# Senha de acesso EXCLUSIVO ao módulo "Sindicatos x Municípios" (a pessoa
# responsável por manter esses dados atualizados). Quem entra com essa senha
# só enxerga e edita esse módulo — não vê Adesões/Escolas/Estatísticas.
# ⚠️ Tem que ser DIFERENTE de ADMIN_PASSWORD e COMISSAO_PASSWORD, senão o
# sistema reconhece como Admin/Comissão antes de chegar a checar essa aqui.
GESTAO_SINDICATO_PASSWORD=escolha-uma-terceira-senha

# Senha de acesso EXCLUSIVO ao módulo "Carreta do Agro" (quem cuida das
# solicitações). Quem entra com essa senha só enxerga e edita esse módulo.
# ⚠️ Também precisa ser DIFERENTE de todas as outras senhas acima.
CARRETA_PASSWORD=escolha-uma-quarta-senha

# (Opcional) Senha de acesso SÓ-VISUALIZAÇÃO ao módulo "Carreta do Agro" —
# vê solicitações, calendário, mapa e bloqueios, mas não pode criar, editar,
# aprovar, cancelar, excluir nem cadastrar bloqueio. Útil pra alguém que só
# precisa acompanhar, sem correr o risco de mexer em algo por engano.
# ⚠️ Também precisa ser DIFERENTE de todas as outras senhas.
CARRETA_LEITURA_PASSWORD=escolha-uma-quinta-senha

# (Opcional) E-mail para avisos automáticos e para o fluxo de assinaturas
# (rascunho salvo, link de assinatura para prefeito/secretário/coordenador).
# Se usar Gmail, gere uma "senha de app" de 16 letras em
# https://myaccount.google.com/apppasswords — a senha normal da conta não funciona.
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=senha-de-app-de-16-letras
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587

# Carreta do Agro: conta de e-mail PRÓPRIA (diferente da de cima), usada só
# pra confirmar solicitações e avisar aprovação/recusa. Sem essas duas
# variáveis, o módulo simplesmente não manda e-mail nenhum (não cai pra
# conta de cima).
CARRETA_MAIL_USERNAME=carretadoagro@nossaorganizacao.com.br
CARRETA_MAIL_PASSWORD=senha-de-app-de-16-letras
# Endereço interno que recebe aviso de solicitação nova (se não informado,
# usa o próprio CARRETA_MAIL_USERNAME como destinatário)
# CARRETA_MAIL_DESTINATARIO=carretadoagro@nossaorganizacao.com.br

# Google Drive (Carreta do Agro): pra quando a integração for plugada —
# conteúdo do JSON da conta de serviço + ID da pasta compartilhada com ela.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_FOLDER_ID=

FLASK_DEBUG=1

# --- Supabase Storage (fotos dos presidentes de sindicato) ---
# Painel do Supabase > Project Settings > API.
# SUPABASE_URL é o "Project URL". SUPABASE_SERVICE_KEY é a chave
# "service_role" — NÃO é a "anon"/pública, essa aqui é secreta, nunca
# exponha no front-end nem versione o .env real.
# Antes de usar, crie um bucket público chamado "sindicatos-fotos" em
# Storage > New bucket (ou mude o nome via SUPABASE_BUCKET_FOTOS).
SUPABASE_URL=https://xfqtjuwovwvdfvbmiuwn.supabase.co
SUPABASE_SERVICE_KEY=preencha-com-a-service-role-key
# SUPABASE_BUCKET_FOTOS=sindicatos-fotos
# Ofícios em PDF da Carreta do Agro: bucket PRIVADO (desmarque "Public
# bucket" ao criar) — diferente do bucket de fotos, que é público. O
# download continua exigindo login de admin, só sai do banco de dados.
# SUPABASE_BUCKET_OFICIOS=carreta-oficios
